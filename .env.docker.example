# Шаблон для Droplet: cp .env.docker.example .env && nano .env
# НЕ комітити .env
# У живому .env заборонено плейсхолдер замість IPv4 — лише реальна адреса.

DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=CHANGE_ME_GENERATE_RANDOM
DEBUG=False

POSTGRES_DB=privattrans
POSTGRES_USER=privattrans
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgres://privattrans:CHANGE_ME_STRONG_PASSWORD@db:5432/privattrans

# Канонічний сайт. Порожній SITE_URL лишає хост запиту (лише локально).
SITE_URL=https://privattrans.com.ua
USE_HTTPS=false

# backend — внутрішнє ім'я сервісу Compose.
# До сертифіката: USE_HTTPS=false і CSRF з http://IP
# Після certbot: USE_HTTPS=true, cookies True, SECURE_SSL_REDIRECT лишається False
# (редирект http→https робить nginx, інакше healthcheck Gunicorn падає).
ALLOWED_HOSTS=privattrans.com.ua,www.privattrans.com.ua,46.101.141.186,127.0.0.1,localhost,backend
CSRF_TRUSTED_ORIGINS=http://46.101.141.186,https://privattrans.com.ua,https://www.privattrans.com.ua

SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# 1GB Droplet — 1 worker; 2GB+ можна 2
GUNICORN_WORKERS=1

# Кілька скриньок — через кому. Приклад: ptinfo@ukr.net,second@example.com
LEAD_NOTIFY_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CRM_WEBHOOK_URL=
GA4_ID=
GTM_ID=
DEFAULT_FROM_EMAIL=noreply@privat-trans.local
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=8
