# Шаблон для Droplet: cp .env.docker.example .env && nano .env
# НЕ комітити .env
# У живому .env заборонено плейсхолдер замість IPv4 — лише реальна адреса.

DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=CHANGE_ME_GENERATE_RANDOM
DEBUG=False

POSTGRES_DB=privattrans
POSTGRES_USER=privattrans
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgres://privattrans:CHANGE_ME_STRONG_PASSWORD@db:5432/privattrans

# Після появи IPv4 допиши його ПЕРШИМ у список (приклад: 203.0.113.10).
# backend — внутрішнє ім'я сервісу Compose (healthcheck / DNS).
# Живий .env: ALLOWED_HOSTS=IP,127.0.0.1,localhost,backend
#             CSRF_TRUSTED_ORIGINS=http://IP
ALLOWED_HOSTS=127.0.0.1,localhost,backend
CSRF_TRUSTED_ORIGINS=http://127.0.0.1

# HTTP-тест (до certbot). Після SSL — True / https://домен
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# 1GB Droplet — 1 worker; 2GB+ можна 2
GUNICORN_WORKERS=1

# Кілька скриньок — через кому. Приклад: ptinfo@ukr.net,second@example.com
LEAD_NOTIFY_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CRM_WEBHOOK_URL=
GA4_ID=
GTM_ID=
DEFAULT_FROM_EMAIL=noreply@privat-trans.local
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=8
